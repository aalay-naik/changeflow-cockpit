# Copy this file to .env and replace the fake values:  cp .env.example .env
# .env holds real secrets and is never committed to Git.

# PostgreSQL (used by infra/docker-compose.yml)
POSTGRES_USER=changeflow
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=changeflow

# Where the frontend server finds the backend API
API_URL=http://localhost:8000
